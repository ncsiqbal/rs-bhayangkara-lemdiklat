cat > .env.example <<'EOF'
# Environment
CI_ENVIRONMENT = production

# Application
app.baseURL = 'https://YOUR-RAILWAY-DOMAIN.up.railway.app'

# Database
database.default.hostname = 'YOUR_MYSQL_HOST'
database.default.database = 'rs_bhayangkara'
database.default.username = 'YOUR_MYSQL_USERNAME'
database.default.password = 'YOUR_MYSQL_PASSWORD'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Encryption
encryption.key = 'GENERATE_YOUR_OWN_KEY'

# Session
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = WRITEPATH . 'session'
EOF